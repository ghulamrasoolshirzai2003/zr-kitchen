# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings → API). See supabase/schema.sql for setup steps.
#
# Until these are filled in, the site keeps working exactly as it does today —
# it just falls back to the menu built into src/data/menuData.js, and ordering
# / admin are disabled with a clear message instead of the app breaking.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
